# MoodTunes Testing Environment Variables Configuration Example

# Base Application URL for Web & API Testing
BASE_URL=http://localhost:8080
TEST_USERNAME=testuser@moodtunes.app
TEST_PASSWORD=TestPass123!

# Appium Mobile Testing Configuration
ANDROID_APP_PATH=app/build/outputs/apk/debug/app-debug.apk
ANDROID_DEVICE_NAME=emulator-5554
APPIUM_SERVER_URL=http://127.0.0.1:4723

# k6 Load Testing Configuration
LOAD_TEST_BASE_URL=http://localhost:8080
PROFILE=smoke

# Security & Vulnerability Scanning Configuration
SECURITY_TEST_TARGET=http://localhost:8080
